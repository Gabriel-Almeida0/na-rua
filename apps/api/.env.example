# Conexão da APLICAÇÃO. Usa o papel narua_app, que NÃO é superuser e NÃO é
# owner das tabelas — é isso que faz FORCE ROW LEVEL SECURITY valer de verdade.
DATABASE_URL=postgres://narua_app:narua_app_dev@localhost:54329/narua

# Conexão de MIGRAÇÃO. Usa o papel dono, que pode criar schema.
# Nunca use esta no servidor da API.
DATABASE_URL_MIGRATOR=postgres://narua:narua_dev@localhost:54329/narua

BETTER_AUTH_SECRET=troque-em-producao-por-um-segredo-de-32-bytes
BETTER_AUTH_URL=http://localhost:3333
WEB_ORIGIN=http://localhost:3000
PORT=3333
