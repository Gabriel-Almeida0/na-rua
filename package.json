{
  "name": "na-rua",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:reset": "docker compose -f infra/docker-compose.yml down -v && pnpm db:up && pnpm db:migrate",
    "db:logs": "docker compose -f infra/docker-compose.yml logs -f postgres",
    "db:migrate": "pnpm --filter @na-rua/api db:migrate && pnpm --filter @na-rua/api db:migrate:auth",
    "dev": "pnpm --parallel --filter @na-rua/api --filter @na-rua/web dev",
    "dev:api": "pnpm --filter @na-rua/api dev",
    "dev:web": "pnpm --filter @na-rua/web dev",
    "build": "pnpm --filter @na-rua/web build",
    "test": "pnpm -r test",
    "test:db": "pnpm --filter @na-rua/api test:db",
    "e2e": "pnpm --filter @na-rua/api e2e",
    "typecheck": "pnpm -r typecheck",
    "verificar": "pnpm typecheck && pnpm test && pnpm test:db && pnpm build"
  },
  "devDependencies": {
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@12.3.4"
}
